<style>
:root {
  --bg:#11110f;
  --panel:#1b1a17;
  --gold:#c9a66b;
  --light:#f5f0e7;
  --muted:#aaa69e;
}

* {
  margin:0;
  padding:0;
  box-sizing:border-box;
  scroll-behavior:smooth;
}

body {
  background:var(--bg);
  color:var(--light);
  font-family:'DM Sans',sans-serif;
  overflow-x:hidden;
}

a {text-decoration:none;color:inherit;}
img {max-width:100%;display:block;}

.container {
  width:min(1160px,90%);
  margin:auto;
}

.gold {color:var(--gold);}

.section {
  padding:100px 0;
}

.section-label {
  color:var(--gold);
  letter-spacing:4px;
  text-transform:uppercase;
  font-size:12px;
  font-weight:700;
  margin-bottom:16px;
}

.section-title {
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(38px,6vw,65px);
  line-height:1.05;
  margin-bottom:22px;
}

.section-description {
  color:var(--muted);
  line-height:1.9;
  max-width:650px;
  font-size:15px;
}

/* NAVIGATION */

header {
  position:fixed;
  top:0;
  width:100%;
  z-index:1000;
  background:rgba(17,17,15,.86);
  backdrop-filter:blur(15px);
  border-bottom:1px solid rgba(201,166,107,.15);
}

nav {
  min-height:78px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo {
  font-family:'Cormorant Garamond',serif;
  font-size:25px;
  font-weight:700;
  letter-spacing:1px;
}

.logo span {color:var(--gold);}

.nav-links {
  display:flex;
  gap:28px;
  align-items:center;
}

.nav-links a {
  font-size:12px;
  color:#ddd6ca;
  transition:.3s;
}

.nav-links a:hover {color:var(--gold);}

.nav-button,.button {
  display:inline-block;
  background:var(--gold);
  color:#171510;
  padding:14px 23px;
  font-size:12px;
  font-weight:800;
  letter-spacing:1px;
  transition:.3s;
}

.button:hover,.nav-button:hover {
  background:var(--light);
  transform:translateY(-3px);
}

/* HERO */

.hero {
  min-height:100vh;
  position:relative;
  display:flex;
  align-items:center;
  overflow:hidden;
  background:
  linear-gradient(90deg,rgba(10,10,9,.94),rgba(10,10,9,.55),rgba(10,10,9,.5)),
  linear-gradient(0deg,var(--bg),transparent 40%),
  url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=90') center/cover;
}

.hero::before {
  content:"CRAFT";
  position:absolute;
  top:17%;
  left:2%;
  font-size:clamp(85px,19vw,260px);
  font-weight:800;
  letter-spacing:-12px;
  color:rgba(255,255,255,.045);
  white-space:nowrap;
}

.hero-content {
  position:relative;
  z-index:2;
  padding-top:95px;
  max-width:750px;
}

.hero-tag {
  color:var(--gold);
  letter-spacing:5px;
  font-size:12px;
  margin-bottom:25px;
}

.hero h1 {
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(65px,10vw,125px);
  line-height:.87;
  margin-bottom:25px;
}

.hero h1 span {
  color:var(--gold);
  display:block;
}

.hero p {
  color:#ded8ce;
  max-width:510px;
  font-size:15px;
  line-height:1.9;
  margin-bottom:32px;
}

.hero-bottom {
  position:absolute;
  bottom:35px;
  right:5%;
  color:var(--gold);
  font-size:11px;
  letter-spacing:3px;
}

/* ABOUT */

.about-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:65px;
  align-items:center;
}

.about-image {
  position:relative;
}

.about-image img {
  width:100%;
  height:530px;
  object-fit:cover;
  filter:brightness(.85);
}

.about-image::after {
  content:"";
  position:absolute;
  inset:15px -15px -15px 15px;
  border:1px solid var(--gold);
  z-index:-1;
}

.about-content p {
  color:var(--muted);
  font-size:14px;
  line-height:2;
  margin-bottom:17px;
}

.signature {
  margin-top:25px;
  border-left:2px solid var(--gold);
  padding-left:17px;
}

.signature strong {
  font-family:'Cormorant Garamond',serif;
  font-size:26px;
  color:var(--gold);
}

/* EXPERTISE */

.expertise {
  background:#191815;
}

.cards {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:24px;
  margin-top:48px;
}

.card {
  background:#22211d;
  border:1px solid rgba(201,166,107,.14);
  overflow:hidden;
  transition:.4s;
}

.card:hover {
  transform:translateY(-8px);
  border-color:var(--gold);
}

.card img {
  width:100%;
  height:230px;
  object-fit:cover;
  transition:.5s;
}

.card:hover img {transform:scale(1.04);}

.card-content {padding:25px;}

.card-content h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:27px;
  margin-bottom:12px;
}

.card-content p {
  font-size:13px;
  line-height:1.8;
  color:var(--muted);
}

/* SERVICES */

.services-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:0 40px;
  margin-top:35px;
}

.service {
  padding:27px 0;
  border-bottom:1px solid rgba(255,255,255,.13);
  display:flex;
  gap:20px;
}

.service-number {
  color:var(--gold);
  font-family:'Cormorant Garamond',serif;
  font-size:28px;
}

.service h3 {
  font-size:16px;
  margin-bottom:9px;
}

.service p {
  color:var(--muted);
  font-size:13px;
  line-height:1.8;
}

/* PROJECTS */

.projects {
  background:#191815;
}

.project-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:20px;
  margin-top:45px;
}

.project {
  position:relative;
  overflow:hidden;
  height:340px;
  background:#222;
}

.project img {
  width:100%;
  height:100%;
  object-fit:cover;
  transition:.5s;
}

.project:hover img {transform:scale(1.07);}

.project-caption {
  position:absolute;
  bottom:0;
  left:0;
  width:100%;
  padding:50px 25px 25px;
  background:linear-gradient(transparent,rgba(0,0,0,.9));
}

.project-caption h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:29px;
}

.project-caption p {
  color:var(--gold);
  font-size:11px;
  margin-top:6px;
  letter-spacing:2px;
}

/* WHY US */

.why-grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:35px;
  margin-top:45px;
}

.why-item {
  border-top:1px solid var(--gold);
  padding-top:23px;
}

.why-item h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:27px;
  margin-bottom:12px;
}

.why-item p {
  color:var(--muted);
  font-size:13px;
  line-height:1.8;
}

/* CTA */

.cta {
  text-align:center;
  padding:90px 20px;
  background:
  linear-gradient(rgba(12,12,10,.84),rgba(12,12,10,.91)),
  url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1800&q=85') center/cover;
}

.cta h2 {
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(40px,7vw,75px);
  margin-bottom:20px;
}

.cta p {
  color:#ccc4b7;
  max-width:600px;
  margin:0 auto 30px;
  line-height:1.9;
}

/* CONTACT */

.contact-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:60px;
  margin-top:40px;
}

.contact-info p {
  color:var(--muted);
  margin-bottom:22px;
  font-size:14px;
  line-height:1.8;
}

.contact-box {
  padding:20px 0;
  border-bottom:1px solid rgba(255,255,255,.12);
}

.contact-box small {
  color:var(--gold);
  letter-spacing:2px;
  font-size:10px;
}

.contact-box p {
  margin:8px 0 0;
  color:var(--light);
  word-break:break-word;
}

.contact-box a:hover {color:var(--gold);}

.contact-photo {
  width:100%;
  height:420px;
  object-fit:cover;
  filter:brightness(.8);
}

/* FOOTER */

footer {
  padding:35px 0;
  background:#090908;
  text-align:center;
  color:#8e897e;
  font-size:12px;
  line-height:2;
}

footer strong {color:var(--gold);}

/* MOBILE */

@media(max-width:800px) {
  .nav-links {display:none;}
  .about-grid,.contact-grid {grid-template-columns:1fr;gap:40px;}
  .cards {grid-template-columns:repeat(2,1fr);}
  .why-grid {grid-template-columns:1fr;}
}

@media(max-width:550px) {
  .section {padding:75px 0;}
  .cards,.project-grid,.services-grid {grid-template-columns:1fr;}
  .hero {min-height:90vh;}
  .hero::before {letter-spacing:-5px;top:23%;}
  .hero h1 {font-size:70px;}
  .about-image img {height:380px;}
  .card img {height:220px;}
  .project {height:280px;}
  .nav-button {padding:11px 14px;font-size:10px;}
}
</style>
</head>

