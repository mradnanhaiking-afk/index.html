<style>
:root {
  --black:#101010;
  --dark:#181818;
  --gold:#c9a66b;
  --white:#f5f1e9;
  --muted:#aaa49a;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--black);color:var(--white);font-family:'DM Sans',sans-serif}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
.container{width:min(1160px,90%);margin:auto}
.gold{color:var(--gold)}
.section{padding:100px 0}
.section-tag{color:var(--gold);letter-spacing:4px;text-transform:uppercase;font-size:12px;margin-bottom:18px}
.section-title{font-family:'Cormorant Garamond',serif;font-size:clamp(40px,6vw,68px);font-weight:500;line-height:1.05;margin-bottom:25px}
.section-desc{color:var(--muted);line-height:1.9;max-width:650px;font-size:15px}
.btn{display:inline-block;padding:15px 28px;background:var(--gold);color:#111;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;transition:.3s}
.btn:hover{background:#e3c18a;transform:translateY(-3px)}
.btn-outline{background:transparent;border:1px solid var(--gold);color:var(--gold)}
.btn-outline:hover{background:var(--gold);color:#111}

/* NAVIGATION */
header{position:absolute;top:0;left:0;width:100%;z-index:10;border-bottom:1px solid #ffffff20}
nav{height:85px;display:flex;align-items:center;justify-content:space-between}
.logo{font-family:'Cormorant Garamond',serif;font-size:27px;letter-spacing:2px;font-weight:700}
.logo span{color:var(--gold)}
.nav-links{display:flex;gap:30px;align-items:center}
.nav-links a{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#eee;transition:.3s}
.nav-links a:hover{color:var(--gold)}
.menu-btn{display:none;background:none;border:0;color:white;font-size:28px}

/* HERO */
.hero{min-height:100vh;position:relative;display:flex;align-items:center;overflow:hidden;background:
linear-gradient(90deg,rgba(0,0,0,.88),rgba(0,0,0,.42)),
url('./images/hero-house.jpg') center/cover no-repeat}
.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#101010 0%,transparent 30%);pointer-events:none}
.hero-content{position:relative;z-index:2;padding-top:100px}
.hero-kicker{color:var(--gold);letter-spacing:5px;font-size:12px;margin-bottom:25px}
.hero h1{font-family:'Cormorant Garamond',serif;font-size:clamp(65px,12vw,145px);line-height:.78;font-weight:600;letter-spacing:2px}
.hero h1 span{display:block;color:var(--gold)}
.hero-subtitle{margin-top:35px;max-width:520px;color:#ddd;line-height:1.9;font-size:15px}
.hero-actions{display:flex;gap:15px;flex-wrap:wrap;margin-top:35px}
.hero-bottom{position:absolute;z-index:3;bottom:35px;right:5%;color:#ddd;font-size:11px;letter-spacing:3px;text-transform:uppercase}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.about-image{height:570px;position:relative;background:#222}
.about-image img{width:100%;height:100%;object-fit:cover}
.about-image:after{content:"";position:absolute;inset:18px -18px -18px 18px;border:1px solid var(--gold);z-index:-1}
.about-copy{padding:20px 0}
.about-copy p{color:var(--muted);line-height:1.95;margin-bottom:18px;font-size:14px}
.signature{font-family:'Cormorant Garamond',serif;font-size:27px;color:var(--gold);margin-top:28px}

/* EXPERTISE */
.expertise{background:#171717}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:50px}
.expert-card{background:#202020;overflow:hidden;transition:.35s}
.expert-card:hover{transform:translateY(-8px)}
.expert-card img{width:100%;height:230px;object-fit:cover;filter:brightness(.8);transition:.4s}
.expert-card:hover img{filter:brightness(1)}
.card-content{padding:25px}
.card-number{color:var(--gold);font-size:12px;letter-spacing:2px}
.card-content h3{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:500;margin:12px 0}
.card-content p{color:var(--muted);font-size:13px;line-height:1.8}

/* SERVICES */
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#39332a;margin-top:45px;border:1px solid #39332a}
.service{background:var(--black);padding:35px 28px;min-height:190px}
.service .number{color:var(--gold);font-size:12px;letter-spacing:2px}
.service h3{font-family:'Cormorant Garamond',serif;font-size:27px;font-weight:500;margin:18px 0 10px}
.service p{color:var(--muted);font-size:13px;line-height:1.7}

/* PROJECTS */
.projects{background:#171717}
.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:45px}
.project{height:340px;position:relative;overflow:hidden;background:#252525}
.project img{width:100%;height:100%;object-fit:cover;transition:.5s;filter:brightness(.72)}
.project:hover img{transform:scale(1.06);filter:brightness(.9)}
.project-label{position:absolute;bottom:25px;left:25px}
.project-label small{color:var(--gold);letter-spacing:3px;text-transform:uppercase}
.project-label h3{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:500;margin-top:5px}

/* WHY US */
.why-grid{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center}
.why-list{margin-top:35px}
.why-item{display:flex;gap:20px;padding:20px 0;border-bottom:1px solid #333}
.why-item .icon{color:var(--gold);font-size:23px}
.why-item h3{font-size:16px;margin-bottom:7px}
.why-item p{color:var(--muted);font-size:13px;line-height:1.7}
.why-image img{width:100%;height:500px;object-fit:cover}

/* CTA */
.cta{padding:100px 0;text-align:center;background:linear-gradient(#000b,#000d),url('./images/hero-house.jpg') center/cover fixed}
.cta .section-title{max-width:750px;margin:0 auto 25px}
.cta p{color:#ccc;margin-bottom:30px}

/* CONTACT */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:45px}
.contact-info p{color:var(--muted);line-height:1.8;margin-bottom:25px}
.contact-item{margin:28px 0}
.contact-item small{display:block;color:var(--gold);letter-spacing:2px;text-transform:uppercase;margin-bottom:8px;font-size:11px}
.contact-item a,.contact-item span{font-size:17px}
.contact-panel{background:#1c1c1c;padding:40px}
.contact-panel h3{font-family:'Cormorant Garamond',serif;font-size:35px;margin-bottom:15px}
.contact-panel p{color:var(--muted);line-height:1.8;margin-bottom:25px}
.contact-actions{display:flex;gap:12px;flex-wrap:wrap}

/* FOOTER */
footer{padding:30px 0;border-top:1px solid #333}
.footer-row{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;color:var(--muted);font-size:12px}
.footer-row span{color:var(--gold)}

@media(max-width:800px){
 .nav-links{display:none;position:absolute;top:85px;left:0;width:100%;background:#151515;padding:25px;flex-direction:column;align-items:flex-start}
 .nav-links.show{display:flex}
 .menu-btn{display:block}
 .about-grid,.why-grid,.contact-grid{grid-template-columns:1fr;gap:45px}
 .about-image{height:420px;margin-right:15px}
 .cards{grid-template-columns:repeat(2,1fr)}
 .services-grid{grid-template-columns:repeat(2,1fr)}
 .project{height:260px}
}
@media(max-width:520px){
 .section{padding:75px 0}
 .cards,.services-grid,.project-grid{grid-template-columns:1fr}
 .hero h1{font-size:65px}
 .hero-subtitle{font-size:14px}
 .project{height:280px}
 .contact-panel{padding:28px}
 .hero-bottom{font-size:9px}
}
</style>
</head>

